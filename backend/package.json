{
  "name": "uuc-bookings-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "dev": "node --env-file-if-exists=.env.local --import tsx src/main.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import.mjs",
    "test": "node --env-file-if-exists=.env.local --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
