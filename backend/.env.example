DATABASE_URL=postgresql://localhost:5432/uuc_pujo
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# Set a long private password and a separate random session-signing secret.
ADMIN_PASSWORD=
SESSION_SECRET=
# mock records a simulated outcome and sends nothing. Never exposed to Expo.
SMS_MODE=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Map your approved template's variable names to booking fields.
# Supported fields: bookingReference, apartmentNumber, amount, customerName, bookingDetails
MSG91_VARIABLE_MAP={"VAR1":"bookingReference","VAR2":"amount"}
SMS_DAILY_LIMIT=100

HOST=127.0.0.1
TEST_DATABASE_URL=postgresql://localhost:5432/uuc_pujo_test
